# Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding Configuration (gemini or local)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Vector DB (Chroma) Configuration
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=rag_gemini_embedding_001_768

# Rate limiting & Retry settings
GEMINI_MAX_RETRIES=5
GEMINI_REQUEST_DELAY_SECONDS=0.2

# LLM Generator Configuration (gemini or ollama)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
OLLAMA_BASE_URL=http://localhost:11434/v1

# Reranker settings (set true to enable CrossEncoder Reranker on GPU)
ENABLE_RERANKER=false

# Authentication Secret
JWT_SECRET=super_secret_enterprise_jwt_key_2026
