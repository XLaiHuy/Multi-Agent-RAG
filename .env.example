# ==============================================================================
# Enterprise Contract Intelligence Platform - Environment Configuration Template
# ==============================================================================

# Environment
ENVIRONMENT=development
DEBUG=false

# Security (In production, must be a 32+ character random secret string)
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini API Authentication
GEMINI_API_KEY=

# Database
# Local SQLite: sqlite:///./data/contracts.db
# Production PostgreSQL: postgresql+psycopg://user:password@host:5432/database
DATABASE_URL=sqlite:///./data/contracts.db

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Storage & Persistence Paths
CHROMA_PATH=./data/chroma
STORAGE_DIR=./data/storage
CHROMA_COLLECTION=enterprise_contracts_v2

# Retrieval & Model Routing
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-TinyBERT-L-2-v2
RERANKER_MAX_SEQ_LENGTH=512
USE_DOCLING_PARSER=false

# Optional HuggingFace Persistent Cache Directory (Set in production container)
# HF_HOME=/data/huggingface
